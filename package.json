{
  "name": "elysia",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Portfolio site for a fictional design and technology studio, built as a zero-framework TypeScript project.",
  "homepage": "https://github.com/elysrea/elysia#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elysrea/elysia.git"
  },
  "bugs": {
    "url": "https://github.com/elysrea/elysia/issues"
  },
  "keywords": [
    "vite",
    "typescript",
    "canvas",
    "design-system",
    "static-site",
    "accessibility",
    "portfolio"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "fonts:sync": "node scripts/sync-fonts.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/syne": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.0"
  }
}
